{
  "schema": 1,
  "id": "cyd-2432s028r",
  "name": "Cheap Yellow Display (ESP32-2432S028R), ILI9341 panel",
  "status": "official",
  "notes": "Tested on the two-port (micro-USB and USB-C) revision. Boards sold under this part number carry one of two panels; if the screen stays white with this profile, try cyd-2432s028r-st7789.",
  "chip": "esp32",
  "usb": ["1A86:7523"],
  "display": {
    "driver": "ILI9341",
    "init": "ili9341-2",
    "width": 240,
    "height": 320,
    "rotation": 1,
    "colourOrder": "RGB",
    "invert": false,
    "spi": { "host": "HSPI", "sclk": 14, "mosi": 13, "miso": 12, "cs": 15, "dc": 2, "rst": -1, "frequency": 40000000 },
    "backlight": { "pin": 21, "activeHigh": true, "pwm": true }
  },
  "touch": {
    "driver": "XPT2046",
    "spi": { "host": "VSPI", "sclk": 25, "mosi": 32, "miso": 39, "cs": 33 },
    "irq": 36
  },
  "led": { "red": 4, "green": 16, "blue": 17, "activeLow": true }
}

  "touch": {
    "driver": "XPT2046",
    "spi": { "host": "VSPI", "sclk": 25, "mosi": 32, "miso": 39, "cs": 33 },
    "irq": 36
  },
  "led": { "red": 4, "green": 16, "blue": 17, "activeLow": true }
}

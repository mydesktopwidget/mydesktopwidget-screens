{
  "schema": 1,
  "id": "cyd-2432s028r-st7789",
  "name": "Cheap Yellow Display (ESP32-2432S028R), ST7789 panel",
  "status": "community",
  "notes": "Not yet tested by the maintainers. Taken from the widely used community TFT_eSPI setup for this panel. Try it if cyd-2432s028r leaves the screen white.",
  "chip": "esp32",
  "usb": ["1A86:7523"],
  "display": {
